# =============================================================================
# Do not commit: .env or any file containing secrets, API keys, or personal
# information (e.g. paths like C:\Users\YourName). Use .env.example as a
# template only (it has no real values).
# =============================================================================

# Environment and secrets (never commit real credentials)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local
.env.backup
.env.old
.env.*.backup
!.env.example

# IDE / editor (may contain local paths or personal settings)
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.cursor/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.cjs

# Next.js (build output can contain absolute paths with your username - never commit)
.next/
out/
build/
dist/

# Debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# Testing / coverage
coverage/
.nyc_output/
*.lcov

# Build / cache
.turbo
*.tsbuildinfo
.cache/
.parcel-cache/

# User uploads (may contain sensitive project data)
public/uploads/

# Local config overrides (may contain personal paths or keys)
*.local.*
local.config.*

# Private keys and certificates (never commit)
*.pem
*.key
*.p12
*.pfx
*.crt

# Credential / secret files (API keys, service accounts)
credentials.json
*-credentials*.json
service-account*.json
.secrets
*.secret

# Vercel / hosting (may link to your account or team)
.vercel

# Backups (may contain old secrets or personal data)
*.bak
*~
*.backup
*.old

# Database dumps (may contain real user data - do not commit)
*.sql.gz
*.dump

# Optional: Prisma (uncomment if you want to avoid committing generated client in some setups)
# node_modules/.prisma/

# Misc
*.pid
*.seed
*.pid.lock
.npm
.eslintcache
.stylelintcache
