# Database (MySQL 8.x - use with MySQL Workbench)
DATABASE_URL="mysql://sitescribe:sitescribe@localhost:3306/sitescribe"

# NextAuth (production’da HTTPS kullanın; secure cookie için NEXTAUTH_URL https:// ile başlamalı)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Storage: "local" (default) or "vercel"
STORAGE_PROVIDER=local
UPLOAD_DIR=public/uploads

# Optional: Vercel Blob (when STORAGE_PROVIDER=vercel)
# BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_STORE_ID=default

# AI (Mistral): CO taslağı, özet, semantik arama, sohbet, sinyal skoru, fotoğraf açıklaması
ENABLE_AI=true
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Opsiyonel: Görsel açıklama (fotoğraf) için Pixtral
# MISTRAL_VISION_MODEL=pixtral-12b-2409

# Optional: E-posta (davet + export)
# RESEND_API_KEY=
# EMAIL_FROM=SiteScribe <noreply@yourdomain.com>

# Cron (zamanlanmış export): Ayarlanmazsa /api/cron/scheduled-export 401 döner
CRON_SECRET=your-random-cron-secret
